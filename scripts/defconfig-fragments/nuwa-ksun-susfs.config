# nuwa-ksun-susfs.config -- REFERENCE for the config deltas of this kernel build
#
# WARNING: this file is NOT consumed by merge_config. Script 04 starts from the **GKI
# config extracted from the stock boot.img** (`state/stock-5.15.194.config`,
# produced by script 06), then applies the deltas below with `scripts/config` +
# `olddefconfig`. Reason: the stock kernel of OS3.0.303 is Google GKI 5.15.194,
# not the MiCode 5.15.41 tree; the stock config is the single source of truth
# for ABI/vermagic.
#
# Base:   state/stock-5.15.194.config (extracted from the stock boot.img)
# Delta:  5 changes compared with the stock config:

# --- 1. KernelSU-Next built-in ---
CONFIG_KSU=y
# (KSU Kconfig: depends on KPROBES && EXT4_FS -- both are already =y in GKI)

# --- 2. ThinLTO instead of FullLTO ---
# CONFIG_LTO_CLANG_FULL disabled, enable:
CONFIG_LTO_CLANG_THIN=y
# Reason: FullLTO needs a lot of RAM for the link step; ThinLTO has been proven
# to build on a 7.7GB RAM machine and does not affect KMI/CRC.

# --- 3. BTF ENABLED (MANDATORY -- never disable) ---
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y
# Reason: DEBUG_INFO_BTF_MODULES adds 2 fields (btf_data_size, btf_data) to
# `struct module`. genksyms hashes structs TRANSITIVELY, so struct module ends
# up in the CRC of nearly every KMI symbol (module_layout + ~63% of symbols) ->
# disabling BTF makes vendor modules get rejected -> BOOTLOOP. This is the real
# root cause of the 2026-11-08 bootloop. Verify: `python3 scripts/verify_kmi_abi.py`
# must pass. If pahole runs out of memory: add swap / use make -j1 for the link
# step -- do NOT disable BTF.
# (History: the kit once disabled BTF to dodge a pahole OOM on a 3.9 GB machine
# -- that was a mistake.)

# --- 4. KMI symbol trimming disabled ---
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_UNUSED_KSYMS_WHITELIST=""
# Reason: the stock whitelist points at absolute paths on Google's build
# machine; disabling trim does not change symbol CRCs, it only keeps extra
# symbols in the kernel.

# --- 5. LOCALVERSION matching stock exactly ---
# CONFIG_LOCALVERSION="-android13-8-00019-gf4321180a397-ab15212794"
# CONFIG_LOCALVERSION_AUTO is not set
# MANDATORY: this is the stock suffix and it decides uname -r/vermagic
# `5.15.194-android13-8-00019-gf4321180a397-ab15212794`. Unlike the old MiCode
# design (empty LOCALVERSION), GKI stock has a suffix, so leaving it empty would
# change vermagic. In addition, make must be invoked with `LOCALVERSION=`
# (empty) on the command line so that setlocalversion does not append '+' when
# the git tree is dirty (script 04 already does this).
#
# CONFIG_MODULES=y, CONFIG_MODVERSIONS=y, CONFIG_CFI_CLANG=y, CONFIG_PREEMPT=y,
# CONFIG_MODULE_UNLOAD=y <- kept as stock, script 04 asserts them.
#
# SUSFS: there is NO CONFIG_KSU_SUSFS symbol in this architecture -- SUSFS runs
# as a separate LKM (kernel/susfs of KSU-Next v3.4.2, built by script 05, loaded
# by ksud).
